{
  "name": "invoice-variant",
  "description": "Invoice-oriented LangExtract eval with document labels that differ from the embedded training example.",
  "tags": ["invoice", "variant", "grounded"],
  "document_text": "Supplier Name: Northwind Wholesale\nBalance Due: $998.50",
  "template_definition": {
    "template_name": "Invoice Variant Extraction Eval",
    "template_version": "1.0.0",
    "document_type": "invoice",
    "description": "Variant invoice LangExtract eval case.",
    "llm_provider_settings": {
      "mode": "local",
      "provider_type": "langextract",
      "provider_label": "LangExtract (Ollama)",
      "api_style": "langextract",
      "base_url": "http://host.docker.internal:11434/v1",
      "model": "qwen3.5:27b",
      "temperature": 0.0,
      "max_tokens": 4000,
      "supports_json_mode": false,
      "allow_external_processing": false,
      "timeout_seconds": 120,
      "retry_count": 2,
      "chunk_size": 16000,
      "langextract_max_document_chars": 160000
    },
    "langextract_config": {
      "prompt_description": "Extract the supplier name and balance due exactly as they appear in the document. Keep every extraction grounded to verbatim spans even when labels vary between invoices.",
      "examples": [
        {
          "text": "Invoice Vendor: Harbor Supply\nTotal Due: $320.15",
          "extractions": [
            {
              "extraction_class": "vendor_name",
              "extraction_text": "Harbor Supply",
              "attributes": {
                "value": "Harbor Supply"
              }
            },
            {
              "extraction_class": "total_amount",
              "extraction_text": "$320.15",
              "attributes": {
                "currency": "USD"
              }
            }
          ]
        }
      ]
    },
    "extracted_fields": [
      {
        "name": "vendor_name",
        "label": "Vendor Name",
        "description": "Supplier listed on the invoice.",
        "type": "text",
        "required": true,
        "citation_required": true,
        "validation": {
          "allow_null": false
        }
      },
      {
        "name": "total_amount",
        "label": "Total Amount",
        "description": "Invoice amount due.",
        "type": "currency",
        "required": true,
        "citation_required": true,
        "validation": {
          "allow_null": false,
          "currency": "USD"
        }
      }
    ],
    "calculated_fields": [
      {
        "name": "amount_with_buffer",
        "label": "Amount With Buffer",
        "description": "Ten percent buffer on invoice total.",
        "type": "calculated",
        "output_type": "currency",
        "formula": "coalesce(total_amount.amount, 0) * 1.10",
        "depends_on": ["total_amount"],
        "validation": {
          "allow_null": false,
          "min": 0
        }
      }
    ],
    "output_settings": {
      "export_formats": ["json"]
    }
  },
  "expected_fields": {
    "vendor_name": {
      "extracted_value": "Northwind Wholesale",
      "normalized_value": {
        "value": "Northwind Wholesale"
      },
      "requires_review": false
    },
    "total_amount": {
      "extracted_value": "$998.50",
      "normalized_value": {
        "amount": 998.5,
        "currency": "USD",
        "display_value": "$998.50"
      },
      "requires_review": false
    }
  },
  "expected_calculated_fields": {
    "amount_with_buffer": {
      "normalized_value": {
        "amount": 1098.35,
        "currency": "USD"
      },
      "requires_review": false
    }
  },
  "expected_review_flags": [],
  "expected_document_level_note_substrings": []
}
