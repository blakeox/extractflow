{
  "name": "statement-basic",
  "description": "Bank-statement LangExtract eval for account holder, statement date, and ending balance extraction.",
  "tags": ["statement", "grounded"],
  "document_text": "Account Holder: Maple Retail Group\nStatement Date: 2026-03-31\nEnding Balance: $18,402.77",
  "template_definition": {
    "template_name": "Statement Extraction Eval",
    "template_version": "1.0.0",
    "document_type": "statement",
    "description": "Bank statement LangExtract eval case.",
    "llm_provider_settings": {
      "mode": "local",
      "provider_type": "langextract",
      "provider_label": "LangExtract (Ollama)",
      "api_style": "langextract",
      "base_url": "http://host.docker.internal:11434/v1",
      "model": "qwen3.5:27b",
      "temperature": 0.0,
      "max_tokens": 4000,
      "supports_json_mode": false,
      "allow_external_processing": false,
      "timeout_seconds": 120,
      "retry_count": 2,
      "chunk_size": 16000,
      "langextract_max_document_chars": 160000
    },
    "langextract_config": {
      "prompt_description": "Extract the account holder, statement date, and ending balance exactly as they appear. Keep every extraction grounded to the statement text.",
      "examples": [
        {
          "text": "Account Name: Cedar Foods LLC\nStatement Date: 2026-01-31\nEnding Balance: $9,110.25",
          "extractions": [
            {
              "extraction_class": "account_holder",
              "extraction_text": "Cedar Foods LLC",
              "attributes": {
                "value": "Cedar Foods LLC"
              }
            },
            {
              "extraction_class": "statement_date",
              "extraction_text": "2026-01-31",
              "attributes": {
                "value": "2026-01-31"
              }
            },
            {
              "extraction_class": "ending_balance",
              "extraction_text": "$9,110.25",
              "attributes": {
                "currency": "USD"
              }
            }
          ]
        }
      ]
    },
    "extracted_fields": [
      {
        "name": "account_holder",
        "label": "Account Holder",
        "description": "Named account holder on the statement.",
        "type": "text",
        "required": true,
        "citation_required": true,
        "validation": {
          "allow_null": false
        }
      },
      {
        "name": "statement_date",
        "label": "Statement Date",
        "description": "Closing date for the statement.",
        "type": "date",
        "required": true,
        "citation_required": true,
        "validation": {
          "allow_null": false
        }
      },
      {
        "name": "ending_balance",
        "label": "Ending Balance",
        "description": "Ending balance shown on the statement.",
        "type": "currency",
        "required": true,
        "citation_required": true,
        "validation": {
          "allow_null": false,
          "currency": "USD"
        }
      }
    ],
    "calculated_fields": [],
    "output_settings": {
      "export_formats": ["json"]
    }
  },
  "expected_fields": {
    "account_holder": {
      "extracted_value": "Maple Retail Group",
      "normalized_value": {
        "value": "Maple Retail Group"
      },
      "requires_review": false
    },
    "statement_date": {
      "extracted_value": "2026-03-31",
      "normalized_value": {
        "value": "2026-03-31",
        "display_value": "2026-03-31"
      },
      "requires_review": false
    },
    "ending_balance": {
      "extracted_value": "$18,402.77",
      "normalized_value": {
        "amount": 18402.77,
        "currency": "USD",
        "display_value": "$18,402.77"
      },
      "requires_review": false
    }
  },
