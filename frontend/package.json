{
  "name": "document-extraction-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build": "tsc && vite build",
    "check:bundle": "node ../scripts/check-frontend-bundle-size.mjs",
    "check:cycles": "madge --circular --extensions ts,tsx --ts-config ./tsconfig.json ./src",
    "check:type-coverage": "type-coverage --project tsconfig.json --at-least 100",
    "knip": "knip --reporter compact",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "env -u FORCE_COLOR -u NO_COLOR -u NODE_DISABLE_COLORS playwright test --grep @a11y",
    "test:e2e": "env -u FORCE_COLOR -u NO_COLOR -u NODE_DISABLE_COLORS playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/eslint-plugin": "^1.6.18",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "knip": "^6.14.1",
    "madge": "^8.0.0",
    "tailwindcss": "^4.3.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.1.3",
    "vitest": "^4.1.7"
  }
}
