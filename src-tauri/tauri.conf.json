{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ExtractFlow",
  "version": "0.1.0",
  "identifier": "com.extractflow.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": "npm run build:ui && ./scripts/prepare-desktop-runtime.sh"
  },
  "app": {
    "windows": [
      {
        "title": "ExtractFlow",
        "width": 1540,
        "height": 980,
        "minWidth": 1220,
        "minHeight": 760,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["resources/desktop-runtime"],
    "category": "Business",
    "shortDescription": "Local-first schema-driven document extraction workspace",
    "longDescription": "ExtractFlow is a desktop shell for local-first, schema-driven document extraction with reusable templates, human review, deterministic formulas, and structured exports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
